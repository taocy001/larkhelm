# LarkHelm log rotation
# Install: sudo cp larkhelm.logrotate /etc/logrotate.d/larkhelm
# (install.sh does this automatically)

__LOG_DIR__/larkhelm.log {
    daily
    rotate 14
    maxsize 256M
    compress
    delaycompress
    copytruncate
    missingok
    notifempty
}

__LOG_DIR__/all.jsonl {
    size 32M
    rotate 7
    compress
    copytruncate
    missingok
    notifempty
}
