<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.larkhelm</string>
  <key>ProgramArguments</key>
  <array>
    <string>__LARKHELM_BIN__</string>
    <string>start</string>
    <string>--config</string>
    <string>__CONFIG__</string>
    <string>--data-dir</string>
    <string>__DATA_DIR__</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
    <key>HOME</key>
    <string>__HOME__</string>
    <key>PATH</key>
    <string>__PATH__</string>
  </dict>
  <!-- RunAtLoad + KeepAlive: auto-start on login and restart on crash -->
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <!-- ThrottleInterval: minimum seconds between restarts (prevents tight loops) -->
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <!-- All output (stdout + stderr) goes to a single log file for easy tailing -->
  <key>StandardOutPath</key>
  <string>__LOG_DIR__/larkhelm.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/larkhelm.log</string>
</dict>
</plist>
