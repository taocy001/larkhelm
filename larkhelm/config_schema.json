{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "larkhelm config",
  "description": "JSON Schema for larkhelm config.json (P1-8). Covers known keys with types/enums/ranges; required fields are NOT enforced so partial / merged configs validate. Unknown keys allowed (`additionalProperties: true`) so newer builds can be validated by older schema files.",
  "type": "object",
  "properties": {
    "APP_ID":           { "type": "string", "minLength": 1 },
    "APP_SECRET":       { "type": "string", "minLength": 1 },
    "claude_command":   { "type": "string" },
    "gemini_command":   { "type": "string" },
    "kimi_command":     { "type": "string" },
    "default_model":    { "enum": ["claude", "gemini", "kimi", "deepseek"] },
    "default_cwd":      { "type": "string" },
    "skip_permissions": { "type": "boolean" },
    "response_timeout": { "type": "integer", "minimum": 10 },
    "hard_timeout":     { "type": "integer", "minimum": 60 },
    "max_card_len":     { "type": "integer", "minimum": 200 },
    "allowed_chat_ids": { "type": "array", "items": { "type": "string" } },
    "gemini_idle_ttl":  { "type": "integer", "minimum": 0 },
    "max_ai_procs":     {
      "oneOf": [
        { "type": "integer", "minimum": 1 },
        { "type": "string",  "enum": ["auto"] },
        { "type": "null" }
      ]
    },
    "timezone":         { "type": "string" },

    "doc_auto_inject":        { "type": "boolean" },
    "doc_inject_max_chars":   { "type": "integer", "minimum": 0 },
    "doc_inject_max_docs":    { "type": "integer", "minimum": 0 },
    "doc_read_max_chars":     { "type": "integer", "minimum": 0 },
    "default_drive_folder":   { "type": "string" },
    "doc_write_confirm":      { "type": "boolean" },
    "doc_write_backend":      { "enum": ["auto", "feishu", "local"] },

    "default_wiki_space_id":     { "type": "string" },
    "default_wiki_parent_token": { "type": "string" },
    "default_owner_open_id":     { "type": "string" },

    "deepseek_api_key":  { "type": "string" },
    "deepseek_base_url": { "type": "string" },
    "deepseek_model":    { "type": "string" },

    "voice_enabled":          { "type": "boolean" },
    "voice_engine":           { "enum": ["faster_whisper", "dashscope"] },
    "voice_api_key":          { "type": "string" },
    "voice_model_size":       { "enum": ["tiny", "base", "small", "medium", "large-v3"] },
    "voice_compute_type":     { "type": "string" },
    "voice_max_duration_ms":  { "type": "integer", "minimum": 1000 },
    "voice_default_lang":     { "enum": ["zh", "en", "auto"] },
    "voice_merge_window_sec": { "type": "integer", "minimum": 0 },
    "voice_max_merge":        { "type": "integer", "minimum": 1 },
    "voice_keep_audio":       { "type": "boolean" },

    "intent_router_enabled":  { "type": "boolean" },
    "intent_router_traffic":  { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "intent_layer2_strategy": { "enum": ["llm", "embedding"] },
    "agent_plugins":          { "type": "array", "items": { "type": "string" } },
    "agent_acl":              { "type": "object" },
    "intent_feedback_path":   { "type": "string" },
    "intent_audit_path":      { "type": "string" },

    "memory_lazy_global":            { "type": "boolean" },
    "memory_project_conditional":    { "type": "boolean" },
    "memory_session_layered":        { "type": "boolean" },
    "memory_recent_turns_dedup":     { "type": "boolean" },
    "memory_cascade_shortcircuit":   { "type": "boolean" },
    "memory_cascade_max_concurrent": { "type": "integer", "minimum": 1 },
    "memory_session_gc_enabled":     { "type": "boolean" },
    "memory_session_gc_max_age_days": { "type": "integer", "minimum": 1 },

    "memory_retriever_enabled":          { "type": "boolean" },
    "memory_retriever_traffic":          { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "memory_retriever_mode":             { "enum": ["auto", "keyword", "embedding", "hybrid"] },
    "memory_retriever_top_k_default":    { "type": "integer", "minimum": 1 },
    "memory_retriever_alpha_recency":    { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "memory_retriever_alpha_importance": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "memory_retriever_alpha_relevance":  { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "memory_retriever_debug_card":       { "type": "boolean" },
    "memory_retriever_audit_path":       { "type": "string" },

    "embedding_backend":          { "enum": ["local", "http", "none"] },
    "embedding_http_endpoint":    { "type": "string" },
    "embedding_model_path":       { "type": "string" },
    "embedding_dim":              { "type": "integer", "minimum": 1 },
    "embedding_http_timeout_sec": { "type": "number", "minimum": 0.0 },
    "embedding_traffic":          { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "embedding_enabled":          { "type": "boolean" },
    "memory_stale_window_days":   { "type": "integer", "minimum": 1 },
    "memory_stale_decay":         { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "memory_audit_rotate_max_mb": { "type": "integer", "minimum": 1 },
    "memory_audit_retain_days":   { "type": "integer", "minimum": 1 },

    "memory_llm_router_enabled":              { "type": "boolean" },
    "memory_llm_router_traffic":              { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "memory_llm_router_max_per_chat_per_min": { "type": "integer", "minimum": 1 },
    "memory_llm_router_cache_ttl_sec":        { "type": "integer", "minimum": 1 },

    "crew_breakpoint_timeout_sec": { "type": "integer", "minimum": 60 },

    "memory_limit_mb": { "type": "integer", "minimum": 128 },

    "oauth_redirect_port": { "type": "integer", "minimum": 0, "maximum": 65535 },

    "backend_health_tick_sec":        { "type": "integer", "minimum": 10 },
    "backend_recover_interval_sec":   { "type": "integer", "minimum": 30 },
    "backend_stale_interval_sec":     { "type": "integer", "minimum": 600 },
    "backend_transient_window_sec":   { "type": "number",  "minimum": 10 },
    "backend_transient_threshold":    { "type": "integer", "minimum": 1 },
    "backend_probe_api_real_call":    { "type": "boolean" },

    "health_endpoint_port": { "type": "integer", "minimum": 0, "maximum": 65535 },
    "health_bind_addr":     { "type": "string" },

    "query_session_v2_enabled":       { "type": "boolean" },
    "memory_session_layer_smart":     { "type": "boolean" },
    "memory_session_layer_budgets": {
      "type": "object",
      "properties": {
        "work_context": { "type": "integer", "minimum": 200 },
        "decisions":    { "type": "integer", "minimum": 100 },
        "history":      { "type": "integer", "minimum": 100 }
      },
      "additionalProperties": false
    },
    "memory_cascade_midflight_cancel": { "type": "boolean" },

    "query_session_v2_traffic":          { "type": "number",  "minimum": 0.0, "maximum": 1.0 },
    "intent_embedding_top_k_threshold":  { "type": "number",  "minimum": 0.0, "maximum": 1.0 },
    "llm_router_circuit_failures":       { "type": "integer", "minimum": 1 },
    "llm_router_circuit_cooldown_sec":   { "type": "number",  "minimum": 1.0 },
    "cascade_backoff_max_attempts":      { "type": "integer", "minimum": 1 },
    "plan_retry_strategy":               { "enum": ["now", "manual", "off"] },
    "plugin_report_card_enabled":        { "type": "boolean" },
    "admin_chat_id":                     { "type": "string" },
    "memory_gc_interval_hours":          { "type": "number",  "minimum": 0.0 },
    "crew_checkpoint_ttl_days":          { "type": "number",  "minimum": 0.0 },
    "dev_stage_timeouts": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 1 }
    },

    "probe_models": {
      "type": "array",
      "items": { "type": "object" }
    },
    "backends": {
      "type": "array",
      "items": { "type": "object" }
    }
  },
  "additionalProperties": true
}
